{% extends 'content/base.html.twig' %}

{% block content_title %}{{ tema.nombre }}{% endblock %}

{% block content_body %}
<div class="content-section">
    <h2>1. ¿Qué es un ERP?</h2>
    <p><strong>ERP (Enterprise Resource Planning)</strong> es un sistema integrado de gestión empresarial que centraliza y automatiza procesos de negocio en diferentes áreas de una organización.</p>
    
    <div class="alert alert-info">
        <strong>Características principales:</strong>
        <ul>
            <li><strong>Integración:</strong> Conecta todos los departamentos en una única base de datos</li>
            <li><strong>Tiempo real:</strong> Información actualizada instantáneamente</li>
            <li><strong>Estandarización:</strong> Procesos uniformes en toda la organización</li>
            <li><strong>Modularidad:</strong> Implementación por módulos según necesidades</li>
        </ul>
    </div>

    <h3>Beneficios de un ERP</h3>
    <ul>
        <li>Eliminación de redundancia de datos</li>
        <li>Mejora en la toma de decisiones con información centralizada</li>
        <li>Automatización de procesos repetitivos</li>
        <li>Reducción de costos operativos</li>
        <li>Cumplimiento normativo y auditoría</li>
        <li>Escalabilidad del negocio</li>
    </ul>
</div>

<div class="content-section">
    <h2>2. Ciclo de Vida de Implementación de ERP</h2>
    
    <h3>Fase 1: Planificación y Análisis</h3>
    <ul>
        <li><strong>Definición de objetivos:</strong> Identificar necesidades del negocio</li>
        <li><strong>Análisis de procesos actuales:</strong> Mapeo de workflows existentes</li>
        <li><strong>Selección de ERP:</strong> Evaluación de proveedores (SAP, Oracle, Microsoft Dynamics, Odoo)</li>
        <li><strong>Análisis de GAP:</strong> Diferencias entre procesos actuales y capacidades del ERP</li>
        <li><strong>Presupuesto y ROI:</strong> Estimación de costos y retorno de inversión</li>
    </ul>

    <h3>Fase 2: Diseño</h3>
    <ul>
        <li>Diseño de arquitectura técnica</li>
        <li>Configuración de módulos seleccionados</li>
        <li>Diseño de personalizaciones necesarias</li>
        <li>Definición de integraciones con sistemas existentes</li>
        <li>Diseño de migración de datos</li>
    </ul>

    <h3>Fase 3: Desarrollo y Configuración</h3>
    <ul>
        <li><strong>Configuración:</strong> Parametrización del sistema sin código</li>
        <li><strong>Personalización:</strong> Desarrollo de funcionalidades específicas</li>
        <li><strong>Desarrollo de interfaces:</strong> Conexión con otros sistemas</li>
        <li><strong>Migración de datos:</strong> Limpieza, transformación y carga (ETL)</li>
    </ul>

    <h3>Fase 4: Testing</h3>
    <ul>
        <li><strong>Pruebas unitarias:</strong> Funcionalidades individuales</li>
        <li><strong>Pruebas de integración:</strong> Interacción entre módulos</li>
        <li><strong>Pruebas de usuario (UAT):</strong> Validación por usuarios finales</li>
        <li><strong>Pruebas de rendimiento:</strong> Carga y estrés del sistema</li>
        <li><strong>Pruebas de seguridad:</strong> Vulnerabilidades y accesos</li>
    </ul>

    <h3>Fase 5: Despliegue (Go-Live)</h3>
    <ul>
        <li><strong>Estrategias de despliegue:</strong>
            <ul>
                <li><strong>Big Bang:</strong> Activación completa en una fecha</li>
                <li><strong>Phased:</strong> Implementación por fases/módulos</li>
                <li><strong>Parallel:</strong> Sistemas antiguo y nuevo simultáneamente</li>
                <li><strong>Pilot:</strong> Prueba en un departamento/ubicación</li>
            </ul>
        </li>
        <li>Capacitación de usuarios finales</li>
        <li>Soporte intensivo post go-live</li>
    </ul>

    <h3>Fase 6: Soporte y Mantenimiento</h3>
    <ul>
        <li>Soporte técnico continuo</li>
        <li>Actualizaciones y parches</li>
        <li>Optimización de procesos</li>
        <li>Mejora continua</li>
    </ul>
</div>

<div class="content-section">
    <h2>3. Módulos Principales de ERP</h2>

    <h3>Módulo de Finanzas (FI/CO)</h3>
    <ul>
        <li><strong>Contabilidad General (FI):</strong> Libro mayor, cuentas por cobrar/pagar</li>
        <li><strong>Controlling (CO):</strong> Contabilidad de costos, centros de costo</li>
        <li><strong>Gestión de Activos:</strong> Activos fijos, depreciaciones</li>
        <li><strong>Tesorería:</strong> Gestión de efectivo, previsiones</li>
        <li><strong>Reporting financiero:</strong> Balance, P&L, cash flow</li>
    </ul>

    <h3>Módulo de Cadena de Suministro (SCM)</h3>
    <ul>
        <li><strong>Gestión de Materiales (MM):</strong> Compras, inventario, almacenes</li>
        <li><strong>Planificación de Producción (PP):</strong> MRP, órdenes de fabricación</li>
        <li><strong>Gestión de Calidad (QM):</strong> Control de calidad, inspecciones</li>
        <li><strong>Logística:</strong> Envíos, recepciones, transporte</li>
    </ul>

    <h3>Módulo de Ventas y Distribución (SD)</h3>
    <ul>
        <li>Gestión de pedidos de venta</li>
        <li>Pricing y condiciones comerciales</li>
        <li>Facturación y crédito</li>
        <li>Gestión de clientes (CRM integrado)</li>
    </ul>

    <h3>Módulo de Recursos Humanos (HCM/HR)</h3>
    <ul>
        <li>Gestión de personal y nóminas</li>
        <li>Reclutamiento y selección</li>
        <li>Formación y desarrollo</li>
        <li>Evaluación de desempeño</li>
        <li>Gestión de tiempo y asistencia</li>
    </ul>

    <h3>Módulo de Gestión de Proyectos (PM)</h3>
    <ul>
        <li>Planificación de proyectos</li>
        <li>Seguimiento de costos y recursos</li>
        <li>Facturación por proyecto</li>
        <li>Gestión de hitos y entregables</li>
    </ul>

    <h3>Módulo de Business Intelligence (BI)</h3>
    <ul>
        <li>Dashboards ejecutivos</li>
        <li>Reportes analíticos</li>
        <li>KPIs y métricas de negocio</li>
        <li>Data warehousing</li>
    </ul>
</div>

<div class="content-section">
    <h2>4. Bases de Datos en ERP</h2>

    <h3>Bases de Datos Relacionales</h3>
    <p>Los ERP utilizan RDBMS para almacenar datos estructurados:</p>
    <ul>
        <li><strong>SAP:</strong> SAP HANA, Oracle, SQL Server, DB2</li>
        <li><strong>Oracle ERP:</strong> Oracle Database</li>
        <li><strong>Microsoft Dynamics:</strong> SQL Server</li>
        <li><strong>Odoo:</strong> PostgreSQL</li>
    </ul>

    <h3>SQL en ERP</h3>
    <div class="code-block">
        <pre><code>-- Consulta de órdenes de venta pendientes
SELECT 
    so.order_number,
    c.customer_name,
    so.order_date,
    so.total_amount,
    so.status
FROM sales_orders so
JOIN customers c ON so.customer_id = c.customer_id
WHERE so.status = 'PENDING'
ORDER BY so.order_date DESC;

-- Análisis de inventario por almacén
SELECT 
    w.warehouse_name,
    p.product_code,
    p.product_name,
    i.quantity_on_hand,
    i.quantity_reserved,
    (i.quantity_on_hand - i.quantity_reserved) AS available_qty
FROM inventory i
JOIN products p ON i.product_id = p.product_id
JOIN warehouses w ON i.warehouse_id = w.warehouse_id
WHERE i.quantity_on_hand > 0;

-- Reporte de ventas por región
SELECT 
    r.region_name,
    COUNT(DISTINCT so.order_id) AS total_orders,
    SUM(so.total_amount) AS total_sales,
    AVG(so.total_amount) AS avg_order_value
FROM sales_orders so
JOIN customers c ON so.customer_id = c.customer_id
JOIN regions r ON c.region_id = r.region_id
WHERE so.order_date >= DATE_SUB(CURDATE(), INTERVAL 1 MONTH)
GROUP BY r.region_name
ORDER BY total_sales DESC;</code></pre>
    </div>

    <h3>Estructura de Tablas Típicas</h3>
    <ul>
        <li><strong>Tablas maestras:</strong> Clientes, proveedores, productos, empleados</li>
        <li><strong>Tablas transaccionales:</strong> Órdenes, facturas, pagos, movimientos</li>
        <li><strong>Tablas de configuración:</strong> Parámetros, catálogos, tipos</li>
        <li><strong>Tablas de auditoría:</strong> Logs, cambios, historial</li>
    </ul>
</div>

<div class="content-section">
    <h2>5. Configuración y Personalización</h2>

    <h3>Configuración (Customizing)</h3>
    <p>Ajustes sin programación mediante parametrización:</p>
    <ul>
        <li>Definición de estructura organizativa (empresas, plantas, centros)</li>
        <li>Configuración de workflows y aprobaciones</li>
        <li>Parametrización de cálculos (impuestos, descuentos)</li>
        <li>Configuración de numeración de documentos</li>
        <li>Definición de roles y permisos</li>
    </ul>

    <h3>Personalización (Customization)</h3>
    <p>Desarrollo de funcionalidades específicas mediante código:</p>
    
    <h4>Ejemplo: ABAP en SAP</h4>
    <div class="code-block">
        <pre><code>*&---------------------------------------------------------------------*
*& Report  Z_SALES_REPORT
*&---------------------------------------------------------------------*
REPORT z_sales_report.

DATA: lt_sales TYPE TABLE OF ztt_sales,
      ls_sales TYPE zts_sales,
      lv_total TYPE p DECIMALS 2.

SELECT order_id customer_name order_date amount
  FROM zsales_orders
  INTO TABLE lt_sales
  WHERE order_date >= sy-datum - 30.

LOOP AT lt_sales INTO ls_sales.
  WRITE: / ls_sales-order_id,
           ls_sales-customer_name,
           ls_sales-order_date,
           ls_sales-amount.
  lv_total = lv_total + ls_sales-amount.
ENDLOOP.

WRITE: / 'Total:', lv_total.</code></pre>
    </div>

    <h4>Ejemplo: JavaScript en NetSuite</h4>
    <div class="code-block">
        <pre><code>/**
 * @NApiVersion 2.1
 * @NScriptType UserEventScript
 */
define(['N/record', 'N/log'], (record, log) => {
    
    const afterSubmit = (context) => {
        if (context.type !== context.UserEventType.CREATE) return;
        
        const salesOrder = context.newRecord;
        const customerId = salesOrder.getValue('entity');
        const orderTotal = salesOrder.getValue('total');
        
        // Actualizar total de ventas del cliente
        const customerRecord = record.load({
            type: record.Type.CUSTOMER,
            id: customerId
        });
        
        const currentTotal = customerRecord.getValue('custentity_total_sales') || 0;
        customerRecord.setValue({
            fieldId: 'custentity_total_sales',
            value: currentTotal + orderTotal
        });
        
        customerRecord.save();
        log.audit('Customer Updated', `Customer ${customerId} total updated`);
    };
    
    return { afterSubmit };
});</code></pre>
    </div>
</div>

