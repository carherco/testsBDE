    <h3>JavaScript (NetSuite)</h3>
    <ul>
        <li>SuiteScript: Framework basado en JavaScript</li>
        <li>APIs: SuiteScript 1.0 y 2.x</li>
        <li>Tipos de scripts: User Event, Client, Scheduled, RESTlet</li>
        <li>Integración con APIs REST</li>
    </ul>

    <h3>Python (Odoo)</h3>
    <div class="code-block">
        <pre><code>from odoo import models, fields, api

class SaleOrder(models.Model):
    _inherit = 'sale.order'
    
    custom_discount = fields.Float(string='Descuento Personalizado')
    
    @api.depends('order_line.price_total', 'custom_discount')
    def _compute_amount_total(self):
        for order in self:
            amount = sum(line.price_total for line in order.order_line)
            discount = amount * (order.custom_discount / 100)
            order.amount_total = amount - discount
    
    def action_apply_discount(self):
        if self.custom_discount > 20:
            raise ValidationError('El descuento no puede superar el 20%')
        self._compute_amount_total()</code></pre>
    </div>

