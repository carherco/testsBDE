    <h4>Async/Await y Fetch API</h4>
    <pre><code>// Función asíncrona para obtener datos
async function obtenerDatos(url) {
    try {
        const response = await fetch(url);
        
        if (!response.ok) {
            throw new Error(`HTTP error! status: ${response.status}`);
        }
        
        const datos = await response.json();
        return datos;
    } catch (error) {
        console.error('Error al obtener datos:', error);
        throw error;
    }
}

// POST request con datos JSON
async function enviarDatos(datos) {
    const response = await fetch('/api/guardar', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
        },
        body: JSON.stringify(datos)
    });
    
    if (!response.ok) {
        throw new Error('Error en el servidor');
    }
    
    return response.json();
}

// Uso con manejo de estados de carga
async function cargarYMostrarDatos() {
    const loading = document.querySelector('.loading');
    const contenido = document.querySelector('.contenido');
    const error = document.querySelector('.error');
    
    try {
        // Mostrar loading
        loading.style.display = 'block';
        contenido.style.display = 'none';
        error.style.display = 'none';
        
        const datos = await obtenerDatos('/api/datos');
        
        // Mostrar datos
        contenido.innerHTML = datos.map(item => 
            `&lt;div class="item"&gt;
                &lt;h3&gt;${item.titulo}&lt;/h3&gt;
                &lt;p&gt;${item.descripcion}&lt;/p&gt;
            &lt;/div&gt;`
        ).join('');
        
        contenido.style.display = 'block';
        
    } catch (err) {
        // Mostrar error
        error.textContent = 'Error al cargar los datos';
        error.style.display = 'block';
    } finally {
        // Ocultar loading
        loading.style.display = 'none';
    }
}</code></pre>

    <h4>Validación de Formularios</h4>
    <pre><code>// Validación personalizada
function validarFormulario(form) {
    const errores = [];
    
    // Validar email
    const email = form.querySelector('#email');
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!emailRegex.test(email.value)) {
        errores.push({ campo: 'email', mensaje: 'Email inválido' });
        marcarError(email);
    }
    
    // Validar teléfono
    const telefono = form.querySelector('#telefono');
    const telRegex = /^[0-9]{9}$/;
    if (telefono.value && !telRegex.test(telefono.value)) {
        errores.push({ campo: 'telefono', mensaje: 'Teléfono debe tener 9 dígitos' });
        marcarError(telefono);
    }
    
    // Validar contraseña
    const password = form.querySelector('#password');
    if (password.value.length < 8) {
        errores.push({ campo: 'password', mensaje: 'Contraseña debe tener al menos 8 caracteres' });
        marcarError(password);
    }
    
    return errores;
}

function marcarError(campo) {
    campo.classList.add('error');
    campo.setAttribute('aria-invalid', 'true');
}

function limpiarErrores(form) {
    form.querySelectorAll('.error').forEach(campo => {
        campo.classList.remove('error');
        campo.removeAttribute('aria-invalid');
    });
    
    form.querySelectorAll('.mensaje-error').forEach(mensaje => {
        mensaje.remove();
    });
}

function mostrarErrores(errores) {
    errores.forEach(error => {
        const campo = document.querySelector(`#${error.campo}`);
        const mensaje = document.createElement('div');
        mensaje.className = 'mensaje-error';
        mensaje.textContent = error.mensaje;
        campo.parentNode.appendChild(mensaje);
    });
}

// Validación en tiempo real
document.querySelectorAll('input').forEach(input => {
    input.addEventListener('blur', () => {
        validarCampo(input);
    });
    
    input.addEventListener('input', () => {
        if (input.classList.contains('error')) {
            validarCampo(input);
        }
    });
});

function validarCampo(campo) {
    // Limpiar errores previos del campo
    campo.classList.remove('error');
    const mensajeError = campo.parentNode.querySelector('.mensaje-error');
    if (mensajeError) {
        mensajeError.remove();
    }
    
    // Validar según el tipo de campo
    let esValido = true;
    let mensaje = '';
    
    if (campo.type === 'email') {
        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (campo.value && !emailRegex.test(campo.value)) {
            esValido = false;
            mensaje = 'Email inválido';
        }
    }
    
    if (!esValido) {
        marcarError(campo);
        const div = document.createElement('div');
        div.className = 'mensaje-error';
        div.textContent = mensaje;
        campo.parentNode.appendChild(div);
    }
}</code></pre>
