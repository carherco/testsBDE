    <h4>Gestión de Eventos</h4>
    <pre><code>// Event listeners básicos
button.addEventListener('click', function(event) {
    console.log('Botón clickeado');
    event.preventDefault(); // Prevenir comportamiento por defecto
});

// Arrow functions
button.addEventListener('click', (e) => {
    console.log('Click con arrow function');
});

// Múltiples eventos
['mouseenter', 'mouseleave'].forEach(evento => {
    elemento.addEventListener(evento, manejarEvento);
});

function manejarEvento(e) {
    console.log(`Evento: ${e.type}`);
}

// Event bubbling y delegation
document.addEventListener('click', (e) => {
    // Event bubbling: el evento sube por el DOM
    console.log('Click detectado en:', e.target);
    
    // Delegación de eventos
    if (e.target.matches('.boton-eliminar')) {
        eliminarElemento(e.target.closest('.item'));
    }
    
