    <h4>Componente Funcional con Hooks</h4>
    <pre><code>import React, { useState, useEffect } from 'react';

function Contador({ inicial = 0, onCambio }) {
    // Hook de estado
    const [contador, setContador] = useState(inicial);
    const [mensaje, setMensaje] = useState('');
    
    // Hook de efecto - se ejecuta después del render
    useEffect(() => {
        document.title = `Contador: ${contador}`;
        
        // Notificar al componente padre
        if (onCambio) {
            onCambio(contador);
        }
        
        // Cleanup function (opcional)
        return () => {
            document.title = 'Mi App';
        };
    }, [contador, onCambio]); // Dependencias
    
    // Event handlers
    const incrementar = () => {
        setContador(prev => prev + 1);
        setMensaje('¡Incrementado!');
        setTimeout(() => setMensaje(''), 2000);
    };
    
    const decrementar = () => {
        setContador(prev => prev - 1);
        setMensaje('¡Decrementado!');
        setTimeout(() => setMensaje(''), 2000);
    };
    
    const reset = () => {
        setContador(inicial);
        setMensaje('Reiniciado');
        setTimeout(() => setMensaje(''), 2000);
    };
    
    return (
        &lt;div className="contador"&gt;
            &lt;h2&gt;Contador: {contador}&lt;/h2&gt;
            
            {mensaje && (
                &lt;p className={`mensaje ${contador > inicial ? 'positivo' : 'negativo'}`}&gt;
                    {mensaje}
                &lt;/p&gt;
            )}
            
            &lt;div className="botones"&gt;
                &lt;button onClick={decrementar} disabled={contador <= 0}&gt;
                    -
                &lt;/button&gt;
                &lt;button onClick={reset}&gt;
                    Reset
                &lt;/button&gt;
                &lt;button onClick={incrementar}&gt;
                    +
                &lt;/button&gt;
            &lt;/div&gt;
            
            {contador > 10 && (
                &lt;div className="alerta"&gt;
                    ¡Contador muy alto!
                &lt;/div&gt;
            )}
        &lt;/div&gt;
    );
}

export default Contador;</code></pre>

    <h4>Lista de Elementos con Estado</h4>
    <pre><code>import React, { useState } from 'react';

function ListaTareas() {
    const [tareas, setTareas] = useState([]);
    const [nuevaTarea, setNuevaTarea] = useState('');
    
    const agregarTarea = (e) => {
        e.preventDefault();
        if (nuevaTarea.trim()) {
            const tarea = {
                id: Date.now(),
                texto: nuevaTarea.trim(),
                completada: false
            };
            setTareas(prev => [...prev, tarea]);
            setNuevaTarea('');
        }
    };
    
    const toggleTarea = (id) => {
        setTareas(prev => 
            prev.map(tarea => 
                tarea.id === id 
                    ? { ...tarea, completada: !tarea.completada }
                    : tarea
            )
        );
    };
    
    const eliminarTarea = (id) => {
        setTareas(prev => prev.filter(tarea => tarea.id !== id));
    };
    
    const tareasCompletadas = tareas.filter(t => t.completada).length;
    
    return (
        &lt;div className="lista-tareas"&gt;
            &lt;h2&gt;Lista de Tareas&lt;/h2&gt;
            
            &lt;form onSubmit={agregarTarea}&gt;
                &lt;input
                    type="text"
                    value={nuevaTarea}
                    onChange={(e) => setNuevaTarea(e.target.value)}
                    placeholder="Nueva tarea..."
                    className="input-tarea"
                /&gt;
                &lt;button type="submit"&gt;Agregar&lt;/button&gt;
            &lt;/form&gt;
            
            &lt;div className="estadisticas"&gt;
                Total: {tareas.length} | Completadas: {tareasCompletadas}
            &lt;/div&gt;
            
            &lt;ul&gt;
                {tareas.map(tarea => (
                    &lt;li key={tarea.id} className={tarea.completada ? 'completada' : ''}&gt;
                        &lt;input 
                            type="checkbox" 
                            checked={tarea.completada}
                            onChange={() => toggleTarea(tarea.id)}
                        /&gt;
                        &lt;span&gt;{tarea.texto}&lt;/span&gt;
                        &lt;button 
                            onClick={() => eliminarTarea(tarea.id)}
                            className="btn-eliminar"
                        &gt;
                            ×
                        &lt;/button&gt;
                    &lt;/li&gt;
                ))}
            &lt;/ul&gt;
            
            {tareas.length === 0 && (
                &lt;p className="mensaje-vacio"&gt;No hay tareas. ¡Agrega una!&lt;/p&gt;
            )}
        &lt;/div&gt;
    );
}</code></pre>

