    <h4>Componente Angular con TypeScript</h4>
    <pre><code>// contador.component.ts
import { Component, Input, Output, EventEmitter, OnInit } from '@angular/core';

@Component({
  selector: 'app-contador',
  template: `
    &lt;div class="contador"&gt;
      &lt;h2&gt;Contador: { { contador } }&lt;/h2&gt;
      
      &lt;p *ngIf="mensaje" [class]="mensajeClase"&gt;
        { { mensaje } }
      &lt;/p&gt;
      
      &lt;div class="botones"&gt;
        &lt;button (click)="decrementar()" [disabled]="contador <= 0"&gt;
          -
        &lt;/button&gt;
        &lt;button (click)="reset()"&gt;
          Reset
        &lt;/button&gt;
        &lt;button (click)="incrementar()"&gt;
          +
        &lt;/button&gt;
      &lt;/div&gt;
      
      &lt;!-- Two-way binding --&gt;
      &lt;div class="control-manual"&gt;
        &lt;label for="valor-manual"&gt;Valor manual:&lt;/label&gt;
        &lt;input 
          id="valor-manual"
          type="number" 
          [(ngModel)]="valorManual"
          (keyup.enter)="establecerValor()"
        &gt;
        &lt;button (click)="establecerValor()"&gt;Establecer&lt;/button&gt;
      &lt;/div&gt;
      
      &lt;div *ngIf="contador > 10" class="alerta"&gt;
        ¡Contador muy alto!
      &lt;/div&gt;
      
      &lt;!-- Lista con *ngFor --&gt;
      &lt;ul *ngIf="historial.length > 0"&gt;
        &lt;li *ngFor="let item of historial; trackBy: trackByFn; let i = index"&gt;
          { { i + 1 } }. { { item.accion } } - Valor: { { item.valor } }
        &lt;/li&gt;
      &lt;/ul&gt;
    &lt;/div&gt;
  `,
  styleUrls: ['./contador.component.css']
})
export class ContadorComponent implements OnInit {
  @Input() inicial: number = 0;
  @Output() cambio = new EventEmitter&lt;number&gt;();
  
  contador: number = 0;
  mensaje: string = '';
  mensajeClase: string = '';
  valorManual: number = 0;
  historial: Array&lt;{accion: string, valor: number}&gt; = [];
  
  ngOnInit() {
    this.contador = this.inicial;
    this.valorManual = this.inicial;
  }
  
  incrementar() {
    this.contador++;
    this.mostrarMensaje('Incrementado', 'positivo');
    this.agregarAlHistorial('Incremento');
    this.emitirCambio();
  }
  
  decrementar() {
    if (this.contador > 0) {
      this.contador--;
      this.mostrarMensaje('Decrementado', 'negativo');
      this.agregarAlHistorial('Decremento');
      this.emitirCambio();
    }
  }
  
  reset() {
    this.contador = this.inicial;
    this.valorManual = this.inicial;
    this.mostrarMensaje('Reiniciado', 'neutral');
    this.agregarAlHistorial('Reset');
    this.emitirCambio();
  }
  
  establecerValor() {
    if (this.valorManual >= 0) {
      this.contador = this.valorManual;
      this.mostrarMensaje('Valor establecido', 'neutral');
      this.agregarAlHistorial('Valor manual');
      this.emitirCambio();
    }
  }
  
  private mostrarMensaje(texto: string, tipo: string) {
    this.mensaje = texto;
    this.mensajeClase = `mensaje ${tipo}`;
    setTimeout(() => {
      this.mensaje = '';
      this.mensajeClase = '';
    }, 2000);
  }
  
  private agregarAlHistorial(accion: string) {
    this.historial.push({ accion, valor: this.contador });
    if (this.historial.length > 5) {
      this.historial.shift(); // Mantener solo los últimos 5
    }
  }
  
  private emitirCambio() {
    this.cambio.emit(this.contador);
  }
  
  trackByFn(index: number, item: any) {
    return index;
  }
}</code></pre>

    <h4>Servicio Angular</h4>
    <pre><code>// datos.service.ts
import { Injectable } from '@angular/core';
import { HttpClient, HttpErrorResponse } from '@angular/common/http';
import { Observable, throwError, BehaviorSubject } from 'rxjs';
import { catchError, map, retry } from 'rxjs/operators';

export interface Usuario {
  id: number;
  nombre: string;
  email: string;
  activo: boolean;
}

@Injectable({
  providedIn: 'root'
})
export class DatosService {
  private apiUrl = '/api';
  private usuariosSubject = new BehaviorSubject&lt;Usuario[]&gt;([]);
  
  // Observable público para que los componentes se suscriban
  usuarios$ = this.usuariosSubject.asObservable();
  
  constructor(private http: HttpClient) {
    this.cargarUsuarios();
  }
  
  obtenerUsuarios(): Observable&lt;Usuario[]&gt; {
    return this.http.get&lt;Usuario[]&gt;(`${this.apiUrl}/usuarios`)
      .pipe(
        retry(3), // Reintentar 3 veces en caso de error
        catchError(this.manejarError)
      );
  }
  
  obtenerUsuario(id: number): Observable&lt;Usuario&gt; {
    return this.http.get&lt;Usuario&gt;(`${this.apiUrl}/usuarios/${id}`)
      .pipe(
        catchError(this.manejarError)
      );
  }
  
  crearUsuario(usuario: Omit&lt;Usuario, 'id'&gt;): Observable&lt;Usuario&gt; {
    return this.http.post&lt;Usuario&gt;(`${this.apiUrl}/usuarios`, usuario)
      .pipe(
        map(nuevoUsuario => {
          // Actualizar el estado local
          const usuariosActuales = this.usuariosSubject.value;
          this.usuariosSubject.next([...usuariosActuales, nuevoUsuario]);
          return nuevoUsuario;
        }),
        catchError(this.manejarError)
      );
  }
  
  actualizarUsuario(id: number, usuario: Partial&lt;Usuario&gt;): Observable&lt;Usuario&gt; {
    return this.http.put&lt;Usuario&gt;(`${this.apiUrl}/usuarios/${id}`, usuario)
      .pipe(
        map(usuarioActualizado => {
          // Actualizar el estado local
          const usuarios = this.usuariosSubject.value;
          const index = usuarios.findIndex(u => u.id === id);
          if (index !== -1) {
            usuarios[index] = usuarioActualizado;
            this.usuariosSubject.next([...usuarios]);
          }
          return usuarioActualizado;
        }),
        catchError(this.manejarError)
      );
  }
  
  eliminarUsuario(id: number): Observable&lt;void&gt; {
    return this.http.delete&lt;void&gt;(`${this.apiUrl}/usuarios/${id}`)
      .pipe(
        map(() => {
          // Actualizar el estado local
          const usuarios = this.usuariosSubject.value;
          this.usuariosSubject.next(usuarios.filter(u => u.id !== id));
        }),
        catchError(this.manejarError)
      );
  }
  
  private cargarUsuarios() {
    this.obtenerUsuarios().subscribe(
      usuarios => this.usuariosSubject.next(usuarios),
      error => console.error('Error al cargar usuarios:', error)
    );
  }
  
  private manejarError(error: HttpErrorResponse) {
    let mensajeError = 'Ocurrió un error desconocido';
    
    if (error.error instanceof ErrorEvent) {
      // Error del lado del cliente
      mensajeError = `Error: ${error.error.message}`;
    } else {
      // Error del lado del servidor
      mensajeError = `Código de error: ${error.status}, mensaje: ${error.message}`;
    }
    
    console.error(mensajeError);
    return throwError(mensajeError);
  }
}</code></pre>

