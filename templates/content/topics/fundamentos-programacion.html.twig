public:
    virtual double area() = 0;
    virtual double perimetro() = 0;
    virtual ~Figura() { }
};

// Clase base con implementación
class FiguraBase {
protected:
    string color;

public:
    virtual double area() = 0;
    
    void setColor(string c) {
        color = c;
    }
};

class Circulo : public Figura {
