{% extends 'content/base.html.twig' %}

{% block content_title %}Tema 3: Fundamentos de Programación{% endblock %}

{% block content_body %}
<div class="content-section">
    <h1>Fundamentos de Programación</h1>
    <p class="lead">Tipos de datos, estructuras de datos fundamentales y algoritmos esenciales con ejemplos prácticos en Python.</p>

    <h2>1. Tipos de Datos en Python</h2>
    <p>Python es un lenguaje de tipado dinámico que ofrece diversos tipos de datos integrados para representar diferentes tipos de información.</p>

    <h3>1.1. Tipos de Datos Básicos</h3>
    
    <h4>Números</h4>
    <ul>
        <li><strong>Enteros (int):</strong> Números sin decimales
            <pre><code>edad = 25
temperatura = -10
respuesta = 42</code></pre>
        </li>
        <li><strong>Punto flotante (float):</strong> Números con decimales
            <pre><code>pi = 3.14
precision = -0.001
valor = 2.0</code></pre>
        </li>
        <li><strong>Complejos (complex):</strong> Números con parte real e imaginaria
            <pre><code>z = 3 + 4j
w = complex(2, -5)  # 2 - 5j
print(z.real)  # 3.0
print(z.imag)  # 4.0</code></pre>
        </li>
    </ul>

    <h4>Texto (str)</h4>
    <p>Cadenas de caracteres, secuencias de texto encerradas en comillas simples o dobles:</p>
    <pre><code>nombre = 'Juan'
mensaje = "Hola mundo"
multilinea = """Este es un
texto de varias
líneas"""

# Operaciones comunes
print(len(nombre))        # 4
print(mensaje.upper())    # HOLA MUNDO
print(nombre + " Pérez")  # Juan Pérez</code></pre>

    <h4>Booleanos (bool)</h4>
    <p>Representan valores lógicos: <code>True</code> (verdadero) o <code>False</code> (falso):</p>
    <pre><code>activo = True
completado = False

# Operaciones lógicas
print(activo and completado)  # False
print(activo or completado)   # True
print(not activo)             # False</code></pre>

    <h3>1.2. Secuencias</h3>

    <h4>Listas (list)</h4>
    <p>Colecciones ordenadas y <strong>mutables</strong> de elementos, definidas con corchetes <code>[]</code>:</p>
    <pre><code>numeros = [1, 2, 3, 4, 5]
mixta = [1, "dos", 3.0, True]

# Operaciones
numeros.append(6)        # Añadir al final
numeros.insert(0, 0)     # Insertar en posición
numeros.remove(3)        # Eliminar valor
elemento = numeros[2]    # Acceso por índice
sublista = numeros[1:4]  # Slicing</code></pre>

    <h4>Tuplas (tuple)</h4>
    <p>Colecciones ordenadas e <strong>inmutables</strong> de elementos, definidas con paréntesis <code>()</code>:</p>
    <pre><code>coordenadas = (10, 20)
persona = ("Juan", 25, "Madrid")

# Acceso
x, y = coordenadas  # Desempaquetado
nombre = persona[0]

# Las tuplas NO se pueden modificar
# persona[1] = 26  # Error!</code></pre>

    <h4>Rango (range)</h4>
    <p>Secuencia inmutable de números, útil para bucles:</p>
    <pre><code>rango = range(5)        # 0, 1, 2, 3, 4
rango2 = range(1, 10)   # 1, 2, 3, ..., 9
rango3 = range(0, 10, 2) # 0, 2, 4, 6, 8

for i in range(5):
    print(i)</code></pre>

    <h3>1.3. Mapeo</h3>

    <h4>Diccionarios (dict)</h4>
    <p>Colecciones de pares clave-valor, definidas con llaves <code>{}</code>:</p>
    <pre><code>persona = {
    "nombre": "Ana",
    "edad": 30,
    "ciudad": "Barcelona"
}

# Acceso y modificación
print(persona["nombre"])     # Ana
persona["edad"] = 31         # Modificar
persona["email"] = "a@b.com" # Añadir

# Métodos útiles
print(persona.keys())        # Claves
print(persona.values())      # Valores
print(persona.items())       # Pares clave-valor</code></pre>

    <h3>1.4. Conjuntos</h3>

    <h4>Conjuntos (set)</h4>
    <p>Colecciones <strong>desordenadas</strong> de elementos <strong>únicos</strong>, definidas con llaves <code>{}</code>:</p>
    <pre><code>numeros = {1, 2, 3, 4, 5}
letras = set(['a', 'b', 'c', 'a'])  # {'a', 'b', 'c'}

# Operaciones
numeros.add(6)           # Añadir
numeros.remove(3)        # Eliminar
numeros.discard(10)      # Eliminar sin error si no existe

# Operaciones de conjuntos
a = {1, 2, 3}
b = {3, 4, 5}
print(a | b)  # Unión: {1, 2, 3, 4, 5}
print(a & b)  # Intersección: {3}
print(a - b)  # Diferencia: {1, 2}</code></pre>

    <h4>Conjuntos congelados (frozenset)</h4>
    <p>Conjuntos <strong>inmutables</strong>:</p>
    <pre><code>inmutable = frozenset([1, 2, 3])
# inmutable.add(4)  # Error! No se puede modificar

# Útil como clave de diccionario
cache = {frozenset([1, 2]): "resultado"}</code></pre>

    <h3>1.5. Tipos Binarios</h3>

    <h4>Bytes (bytes)</h4>
    <p>Secuencias <strong>inmutables</strong> de bytes (0-255):</p>
    <pre><code>datos = b'Hola'
datos2 = bytes([72, 111, 108, 97])

# Conversión
texto = "Hola"
bytes_texto = texto.encode('utf-8')
texto_recuperado = bytes_texto.decode('utf-8')</code></pre>

    <h4>Bytearray (bytearray)</h4>
    <p>Secuencias <strong>mutables</strong> de bytes:</p>
    <pre><code>ba = bytearray(b'Hola')
ba[0] = 74  # Modificar primer byte
ba.append(33)  # Añadir byte</code></pre>

    <h4>Memoryview (memoryview)</h4>
    <p>Proporciona una vista de la memoria de otro objeto binario sin copiar:</p>
    <pre><code>datos = bytearray(b'Hola Mundo')
vista = memoryview(datos)
print(vista[0:4].tobytes())  # b'Hola'

# Modificar a través de la vista
vista[0] = 74  # Cambia 'H' por 'J'</code></pre>

    <h3>1.6. Conversión entre Tipos</h3>
    <pre><code># A entero
int("42")      # 42
int(3.14)      # 3
int(True)      # 1

# A flotante
float("3.14")  # 3.14
float(42)      # 42.0

# A cadena
str(42)        # "42"
str(3.14)      # "3.14"
str([1, 2])    # "[1, 2]"

# A lista
list("abc")    # ['a', 'b', 'c']
list((1, 2))   # [1, 2]

# A tupla
tuple([1, 2])  # (1, 2)

# A conjunto
set([1, 2, 2]) # {1, 2}</code></pre>

    <div class="alert alert-info">
        <h5>💡 Mutabilidad vs Inmutabilidad</h5>
        <ul class="mb-0">
            <li><strong>Mutables:</strong> list, dict, set, bytearray (se pueden modificar)</li>
            <li><strong>Inmutables:</strong> int, float, str, tuple, frozenset, bytes (no se pueden modificar)</li>
            <li>Los objetos inmutables son más seguros y eficientes en memoria</li>
        </ul>
    </div>

    <h2>1.7. Tipos de Datos en Java</h2>
    <p>Java es un lenguaje de tipado estático fuertemente tipado. Distingue entre tipos primitivos y tipos de referencia (objetos).</p>

    <h3>Tipos Primitivos</h3>

    <h4>Números Enteros</h4>
    <pre><code>byte edad = 25;        // 8 bits: -128 a 127
short año = 2024;      // 16 bits: -32,768 a 32,767
int poblacion = 1000000; // 32 bits: -2^31 a 2^31-1
long distancia = 9223372036854775807L; // 64 bits</code></pre>

    <h4>Números Decimales</h4>
    <pre><code>float precio = 19.99f;  // 32 bits, precisión simple
double pi = 3.141592653589793; // 64 bits, precisión doble</code></pre>

    <h4>Caracteres y Booleanos</h4>
    <pre><code>char letra = 'A';       // 16 bits Unicode
boolean activo = true;  // true o false</code></pre>

    <h3>Tipos de Referencia (Objetos)</h3>

    <h4>String</h4>
    <pre><code>String nombre = "Juan";
String mensaje = "Hola " + nombre;
int longitud = nombre.length();
String mayusculas = nombre.toUpperCase();</code></pre>

    <h4>Arrays</h4>
    <pre><code>// Array de tamaño fijo
int[] numeros = {1, 2, 3, 4, 5};
int[] vacio = new int[10];
String[] nombres = {"Ana", "Luis", "María"};

// Acceso
int primero = numeros[0];
numeros[2] = 10;</code></pre>

    <h4>Colecciones (java.util)</h4>
    <pre><code>// ArrayList - lista dinámica
ArrayList&lt;String&gt; lista = new ArrayList&lt;&gt;();
lista.add("elemento");
lista.remove(0);
String item = lista.get(0);

// HashMap - diccionario
HashMap&lt;String, Integer&gt; edades = new HashMap&lt;&gt;();
edades.put("Ana", 25);
edades.put("Luis", 30);
int edad = edades.get("Ana");

// HashSet - conjunto
HashSet&lt;Integer&gt; unicos = new HashSet&lt;&gt;();
unicos.add(1);
unicos.add(2);
unicos.add(1); // No se duplica

// LinkedList - lista enlazada
LinkedList&lt;String&gt; cola = new LinkedList&lt;&gt;();
cola.addLast("primero");
cola.addLast("segundo");
String primero = cola.removeFirst();</code></pre>

    <h4>Wrapper Classes</h4>
    <p>Clases que envuelven tipos primitivos para usarlos como objetos:</p>
    <pre><code>Integer num = 42;           // Autoboxing
int valor = num;            // Unboxing
Double decimal = 3.14;
Boolean flag = true;
Character c = 'A';

// Métodos útiles
int parsed = Integer.parseInt("123");
String str = Integer.toString(42);</code></pre>

    <h3>Conversión de Tipos en Java</h3>
    <pre><code>// Casting implícito (widening)
int i = 100;
long l = i;
double d = l;

// Casting explícito (narrowing)
double pi = 3.14;
int entero = (int) pi;  // 3

// String a primitivo
int num = Integer.parseInt("42");
double dec = Double.parseDouble("3.14");

// Primitivo a String
String s1 = String.valueOf(42);
String s2 = Integer.toString(42);</code></pre>

    <div class="alert alert-warning">
        <h5>⚠️ Diferencias clave Java vs Python</h5>
        <ul class="mb-0">
            <li><strong>Tipado:</strong> Java es estático (declarar tipo), Python es dinámico</li>
            <li><strong>Primitivos:</strong> Java tiene tipos primitivos, Python todo son objetos</li>
            <li><strong>Arrays:</strong> Java arrays son de tamaño fijo, Python listas son dinámicas</li>
            <li><strong>Null:</strong> Java usa <code>null</code>, Python usa <code>None</code></li>
        </ul>
    </div>

    <h2>1.8. Tipos de Datos en C++</h2>
    <p>C++ es un lenguaje de tipado estático con control de bajo nivel sobre la memoria.</p>

    <h3>Tipos Fundamentales</h3>

    <h4>Números Enteros</h4>
    <pre><code>char c = 'A';              // 8 bits (también usado para caracteres)
short s = 32000;           // 16 bits
int i = 2147483647;        // 32 bits (típicamente)
long l = 2147483647L;      // 32 o 64 bits (depende del sistema)
long long ll = 9223372036854775807LL; // 64 bits

// Versiones sin signo
unsigned int positivo = 4294967295U;
unsigned char byte = 255;</code></pre>

    <h4>Números Decimales</h4>
    <pre><code>float f = 3.14f;           // 32 bits, ~7 dígitos precisión
double d = 3.14159265359;  // 64 bits, ~15 dígitos precisión
long double ld = 3.14159265358979323846L; // 80+ bits</code></pre>

    <h4>Booleanos</h4>
    <pre><code>bool activo = true;
bool completado = false;</code></pre>

    <h3>Tipos Derivados</h3>

    <h4>Arrays</h4>
    <pre><code>// Array estático
int numeros[5] = {1, 2, 3, 4, 5};
int matriz[3][3] = { {1,2,3}, {4,5,6}, {7,8,9} };

// Acceso
int primero = numeros[0];
numeros[2] = 10;</code></pre>

    <pre><code>
int x = 42;
int* ptr = &x;        // Puntero a x
int& ref = x;         // Referencia a x

*ptr = 50;            // Modifica x a través del puntero
ref = 60;             // Modifica x a través de la referencia

cout << x;            // 60
</code></pre>

    <h4>Strings (C++)</h4>
    <pre><code>#include &lt;string&gt;

std::string nombre = "Juan";
std::string mensaje = "Hola " + nombre;
int longitud = nombre.length();
std::string mayusculas = nombre;
// No hay método toUpperCase() directo, usar transform</code></pre>

    <h4>C-style Strings</h4>
    <pre><code>char nombre[20] = "Juan";
char mensaje[] = "Hola mundo";
int longitud = strlen(nombre);
strcpy(nombre, "Pedro");</code></pre>

    <h3>STL (Standard Template Library)</h3>

    <h4>Vector - array dinámico</h4>
    <pre><code>#include &lt;vector&gt;

std::vector&lt;int&gt; numeros = {1, 2, 3, 4, 5};
numeros.push_back(6);      // Añadir al final
numeros.pop_back();        // Eliminar último
int primero = numeros[0];
int tamaño = numeros.size();</code></pre>

    <h4>Map - diccionario</h4>
    <pre><code>#include &lt;map&gt;

std::map&lt;std::string, int&gt; edades;
edades["Ana"] = 25;
edades["Luis"] = 30;
int edad = edades["Ana"];

// Verificar existencia
if (edades.find("Ana") != edades.end()) {
    // Existe
}</code></pre>

    <h4>Set - conjunto</h4>
    <pre><code>#include &lt;set&gt;

std::set&lt;int&gt; unicos;
unicos.insert(1);
unicos.insert(2);
unicos.insert(1);  // No se duplica

// Verificar existencia
if (unicos.find(1) != unicos.end()) {
    // Existe
}</code></pre>

    <h4>List - lista enlazada</h4>
    <pre><code>#include &lt;list&gt;

std::list&lt;int&gt; lista;
lista.push_back(1);
lista.push_front(0);
lista.pop_back();
lista.pop_front();</code></pre>

    <h4>Queue y Stack</h4>
    <pre><code>#include &lt;queue&gt;
#include &lt;stack&gt;

// Cola (FIFO)
std::queue&lt;int&gt; cola;
cola.push(1);
cola.push(2);
int primero = cola.front();
cola.pop();

// Pila (LIFO)
std::stack&lt;int&gt; pila;
pila.push(1);
pila.push(2);
int tope = pila.top();
pila.pop();</code></pre>

    <h3>Conversión de Tipos en C++</h3>
    <pre><code>// Casting estilo C
int i = 42;
double d = (double)i;

// Casting estilo C++
double pi = 3.14;
int entero = static_cast&lt;int&gt;(pi);

// String a número (C++11)
#include &lt;string&gt;
std::string str = "42";
int num = std::stoi(str);
double dec = std::stod("3.14");

// Número a string
int x = 42;
std::string s = std::to_string(x);</code></pre>

    <h3>Gestión de Memoria</h3>
    <pre><code>// Memoria dinámica (heap)
int* ptr = new int(42);
delete ptr;

int* arr = new int[10];
delete[] arr;

// Smart pointers (C++11) - gestión automática
#include &lt;memory&gt;

std::unique_ptr&lt;int&gt; uptr = std::make_unique&lt;int&gt;(42);
std::shared_ptr&lt;int&gt; sptr = std::make_shared&lt;int&gt;(42);
// No necesitan delete, se liberan automáticamente</code></pre>

    <div class="alert alert-danger">
        <h5>⚠️ Características únicas de C++</h5>
        <ul class="mb-0">
            <li><strong>Gestión manual de memoria:</strong> new/delete (o smart pointers)</li>
            <li><strong>Punteros:</strong> Acceso directo a direcciones de memoria</li>
            <li><strong>Referencias:</strong> Alias a variables existentes</li>
            <li><strong>Tamaño de tipos:</strong> Puede variar según arquitectura (usar sizeof())</li>
            <li><strong>Sin garbage collector:</strong> El programador controla la memoria</li>
        </ul>
    </div>

    <h2>1.9. Comparativa de Tipos de Datos</h2>
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Concepto</th>
                <th>Python</th>
