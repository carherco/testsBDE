            <h6>Python (Properties)</h6>
            <pre><code>class Persona:
    def __init__(self, nombre):
        self._nombre = nombre
        self._edad = 0
    
    @property
    def nombre(self):
        return self._nombre
    
    @nombre.setter
    def nombre(self, valor):
        if valor:
            self._nombre = valor
    
    @property
    def edad(self):
        return self._edad
    
    @edad.setter
    def edad(self, valor):
        if valor >= 0:
            self._edad = valor

p = Persona("Ana")
print(p.nombre)  # Usa getter
p.edad = 25      # Usa setter
print(p.edad)
</code></pre>
