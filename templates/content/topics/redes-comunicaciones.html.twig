            <tr><td>POP3</td><td>110 TCP</td><td>POP3S 995 TCP</td></tr>
            <tr><td>DNS</td><td>53 TCP/UDP</td><td>DNS sobre TLS 853 TCP</td></tr>
            <tr><td>DHCP</td><td>67/68 UDP</td><td>—</td></tr>
            <tr><td>NTP</td><td>123 UDP</td><td>—</td></tr>
