{% extends 'base.html.twig' %}

{% block title %}Resultado - Pregunta {{ current }}/{{ total }}{% endblock %}

{% block body %}
<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">📊 Resultado</h5>
                    <span class="badge bg-primary">{{ current }}/{{ total }}</span>
                </div>
                <div class="card-body">
                    <div class="mb-4">
                        <h6>{{ pregunta.texto }}</h6>
                    </div>

                    {% if acertada %}
                        <div class="alert alert-success">
                            <h5>✅ ¡Correcto!</h5>
                            <p class="mb-0">Has seleccionado la respuesta correcta.</p>
                        </div>
                    {% else %}
                        <div class="alert alert-danger">
                            <h5>❌ Incorrecto</h5>
                            {% if pregunta.correcta|lower == 'a' %}
                                <p class="mb-0">La respuesta correcta era: <strong>{{ pregunta.opcionA }}</strong></p>
                            {% elseif pregunta.correcta|lower == 'b' %}
                                <p class="mb-0">La respuesta correcta era: <strong>{{ pregunta.opcionB }}</strong></p>
                            {% elseif pregunta.correcta|lower == 'c' %}
                                <p class="mb-0">La respuesta correcta era: <strong>{{ pregunta.opcionC }}</strong></p>
                            {% else %}
                                <p class="mb-0">La respuesta correcta era: <strong>{{ pregunta.opcionD }}</strong></p>
                            {% endif %}
                        </div>
                    {% endif %}

                    <div class="mb-4">
                        <h6>Opciones:</h6>
                        {% set opciones_originales = {
                            'a': pregunta.opcionA,
                            'b': pregunta.opcionB,
                            'c': pregunta.opcionC,
                            'd': pregunta.opcionD
                        } %}
                        
                        {% for letra_mostrada in ['a', 'b', 'c', 'd'] %}
                            {% set letra_original = mapeo[letra_mostrada] %}
                            {% set es_correcta = (letra_original == pregunta.correcta|lower) %}
                            {% set fue_seleccionada = (letra_mostrada == respuesta_mostrada) %}
                            
                            <p class="mb-2 {% if es_correcta %}text-success fw-bold{% endif %}">
                                {{ letra_mostrada|upper }}) {{ opciones_originales[letra_original] }}
                                {% if es_correcta %}✓{% endif %}
                                {% if fue_seleccionada and not acertada %}<span class="text-danger">← Tu respuesta</span>{% endif %}
                            </p>
                        {% endfor %}
                    </div>

                    {% if pregunta.explicacion %}
                        <div class="alert alert-info">
                            <h6>💡 Explicación</h6>
                            <p class="mb-0">{{ pregunta.explicacion }}</p>
                        </div>
                    {% endif %}

                    <div class="mb-3">
                        <a href="{{ path('app_content_show', {id: pregunta.tema.id}) }}" class="btn btn-outline-primary btn-sm" target="_blank">
                            📚 Ver contenido del tema: {{ pregunta.tema.nombre }}
                        </a>
                    </div>

                    <div class="d-grid">
                        {% if current < total %}
                            <a href="{{ path('app_practice_next') }}" class="btn btn-primary">➡️ Siguiente Pregunta</a>
                        {% else %}
                            <a href="{{ path('app_practice_summary') }}" class="btn btn-success">📋 Ver Resumen Final</a>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
